PORT=3000

# Server-only Supabase credentials. Prefer the rotatable sb_secret_ key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STATE_ID=default

# Server-only Stripe Billing credentials. Never expose these in browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_API_VERSION=2026-10-28.endive

# Canonical production origin used for Stripe success/cancel/portal redirects.
PUBLIC_APP_URL=https://dailydividend.info

# Secret server-side key for end-of-day prices from Twelve Data.
TWELVE_DATA_API_KEY=

# Publishable Logo.dev token used by the server-side logo cache.
LOGO_DEV_TOKEN=

# Supabase Storage bucket for curated company logos.
SUPABASE_LOGO_BUCKET=company-logos
